<Window x:Class="FocusGuard.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FocusGuard 设置"
        Width="440" Height="640"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- 圆角按钮模板：Background/Foreground/Padding 由各 Style 透传到模板里 -->
        <ControlTemplate x:Key="RoundButtonTemplate" TargetType="Button">
            <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"
                                  TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.86" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RoundButtonTemplate}" />
            <Setter Property="Background" Value="#185FA5" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EEF1F4" />
            <Setter Property="Foreground" Value="#374151" />
        </Style>

        <Style x:Key="RemoveButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <!-- 列表行：正文在左、操作在右，行间用浅色分隔线 -->
        <DataTemplate x:Key="SiteRow">
            <Border BorderBrush="#F1F2F4" BorderThickness="0,0,0,1" Padding="0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding Site}"
                               FontSize="13" Foreground="#374151"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding Hostnames.Count, StringFormat={}{0} 个域名}"
                               FontSize="11" Foreground="#9CA3AF"
                               VerticalAlignment="Center" Margin="10,0,10,0" />
                    <Button Grid.Column="2"
                            Style="{StaticResource RemoveButton}"
                            Content="移除"
                            Tag="{Binding}"
                            Click="RemoveSite_Click" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 屏蔽程序行：文件名 + 完整路径，行间用浅色分隔线 -->
        <DataTemplate x:Key="ExeRow">
            <Border BorderBrush="#F1F2F4" BorderThickness="0,0,0,1" Padding="0,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Name}"
                                   FontSize="13" Foreground="#374151" />
                        <TextBlock Text="{Binding FilePath}"
                                   FontSize="11" Foreground="#9CA3AF"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button Grid.Column="1"
                            Style="{StaticResource RemoveButton}"
                            Content="移除"
                            Tag="{Binding}"
                            Click="RemoveExe_Click" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Border x:Name="Root"
            CornerRadius="16"
            Background="#FAFAFA"
            BorderBrush="#E5E7EB"
            BorderThickness="1"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="20,14,12,0">
                <Button x:Name="CloseButton"
                        DockPanel.Dock="Right"
                        Content="✕"
                        Width="26" Height="26"
                        FontSize="13"
                        Foreground="#B4B2A9"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        FocusVisualStyle="{x:Null}"
                        Click="Cancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <TextBlock Text="设置"
                           FontSize="12"
                           Foreground="#9CA3AF"
                           VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="1" Margin="20,4,20,4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 专注进行中打开设置时的提示：本次已写入 hosts 的规则不变 -->
                    <TextBlock x:Name="FocusingNote"
                               Text="专注进行中：更改将在下一次专注时生效"
                               FontSize="11"
                               Foreground="#B45309"
                               Margin="0,0,0,8"
                               Visibility="Collapsed" />

                    <TextBlock Text="屏蔽网站"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151" />
                    <TextBlock Text="输入一个主域名（如 hupu.com 或 www.hupu.com），将自动屏蔽其 www、m、bbs 等常见子域"
                               FontSize="11" Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               Margin="0,4,0,8" />

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SiteInput"
                                 Height="32"
                                 FontSize="13"
                                 Foreground="#374151"
                                 CaretBrush="#374151"
                                 Background="#FFFFFF"
                                 BorderBrush="#E5E7EB"
                                 BorderThickness="1"
                                 Padding="8,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SiteInput_KeyDown" />
                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Content="添加"
                                Width="64"
                                Margin="8,0,0,0"
                                Click="AddSite_Click" />
                    </Grid>

                    <TextBlock x:Name="SiteMessage"
                               Text=""
                               FontSize="11"
                               Foreground="#DC2626"
                               Margin="0,0,0,6"
                               TextWrapping="Wrap"
                               Visibility="Collapsed" />

                    <ItemsControl x:Name="SiteList"
                                  ItemTemplate="{StaticResource SiteRow}" />

                    <TextBlock Text="屏蔽程序"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#374151"
                               Margin="0,18,0,4" />
                    <TextBlock Text="从资源管理器选择 exe 文件加入屏蔽：开始专注时结束其全部进程；勾选下方选项后，专注期间还会锁定文件本身，防止中途再次启动"
                               FontSize="11" Foreground="#9CA3AF"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />

                    <Button Style="{StaticResource SecondaryButton}"
                            Content="浏览添加…"
                            HorizontalAlignment="Left"
                            Width="110"
                            Click="BrowseExes_Click" />

                    <ItemsControl x:Name="ExeList"
                                  ItemTemplate="{StaticResource ExeRow}"
                                  Margin="0,6,0,0" />

                    <CheckBox x:Name="LockFilesCheck"
                              Content="专注期间锁定文件（改名防止启动，结束专注后自动恢复）"
                              FontSize="12"
                              Foreground="#374151"
                              Margin="0,10,0,0"
                              Cursor="Hand" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="20,10,20,16">
                <Button Style="{StaticResource PrimaryButton}"
                        Content="保存"
                        Width="88"
                        Click="Save_Click" />
                <Button Style="{StaticResource SecondaryButton}"
                        Content="取消"
                        Width="88"
                        Margin="10,0,0,0"
                        Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
